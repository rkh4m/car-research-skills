{
  "name": "car-research-skills",
  "version": "0.0.1",
  "description": "Agent skills and a scoring engine for evidence-first used-car research.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "car-research": "./src/cli/index.ts"
  },
  "scripts": {
    "score": "tsx src/cli/index.ts score",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "smoke:live": "tsx --test \"tests/live/*.live.ts\""
  },
  "dependencies": {
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.13",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
